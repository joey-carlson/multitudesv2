# Multitudes v2.0 - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=Multitudes
APP_VERSION=2.0.0
ENVIRONMENT=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true  # Set to false in production

# =============================================================================
# Security & Authentication
# =============================================================================
# Generate a secure key with: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Encryption key for sensitive data (credentials, etc.)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-here

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://multitudes:password@localhost:5432/multitudes_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token-here
INFLUXDB_ORG=multitudes
INFLUXDB_BUCKET=multitudes-data

# Redis (for caching and Celery)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# =============================================================================
# Celery Configuration
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# AI/ML Services
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# Vector Database (Future)
# PINECONE_API_KEY=your-pinecone-key
# PINECONE_ENVIRONMENT=us-east-1-aws

# =============================================================================
# Data Source Integrations
# =============================================================================

# Apple Mail & Calendar (Mac only)
APPLE_MAIL_ENABLED=true
APPLE_CALENDAR_ENABLED=true

# Google (Gmail & Calendar)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/calendar.readonly

# Microsoft Outlook
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret
OUTLOOK_TENANT_ID=common
OUTLOOK_REDIRECT_URI=http://localhost:8000/auth/outlook/callback
OUTLOOK_SCOPES=Mail.Read,Calendars.Read

# =============================================================================
# Streamlit Dashboard
# =============================================================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_SERVER_HEADLESS=false
STREAMLIT_THEME_PRIMARY_COLOR=#FF6B6B
STREAMLIT_THEME_BACKGROUND_COLOR=#FFFFFF
STREAMLIT_THEME_SECONDARY_BACKGROUND_COLOR=#F0F2F6

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# =============================================================================
# CORS Settings
# =============================================================================
CORS_ORIGINS=http://localhost:8501,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_ALLOW_HEADERS=*

# =============================================================================
# Logging
# =============================================================================
LOG_FILE_PATH=logs/multitudes.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_PERSONA_DISCOVERY=true
FEATURE_ENERGY_TRACKING=true
FEATURE_AI_INSIGHTS=true
FEATURE_AUTO_TASK_ROUTING=false  # Coming soon

# =============================================================================
# Development/Testing
# =============================================================================
# Set to true to use mock external APIs during development
USE_MOCK_APIS=false
TEST_DATABASE_URL=postgresql+asyncpg://multitudes:password@localhost:5432/multitudes_test
